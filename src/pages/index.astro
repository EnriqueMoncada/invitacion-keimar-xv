---
/* ============================================================
   INVITACIÓN XV AÑOS — KEIMAR DE LOS ÁNGELES
   Estilo: gala / discoteca neón plateada (según referencia Invitio)
   ─────────────────────────────────────────────────────────
   ✏️  Los datos editables están en el bloque `datos` de abajo.
   Foto de portada: colocar en /public/assets/keimar.jpg
   ============================================================ */
const datos = {
  nombre: "Keimar de Los Ángeles",
  nombrePortada: ["Keimar", "de Los Ángeles"], // línea 1 y 2 del neón

  // 👨‍👩‍👧 Padres
  padres: ["Fernando", "Keiny"],

  // 📅 Evento: Domingo 27-Dic-2026, 9:00 pm
  fechaEvento: new Date(2026, 11, 27, 21, 0, 0),
  fechaTexto: "Domingo",
  fechaNumerica: "27 - Dic - 2026",
  horaTexto: "9:00 pm",

  // 📍 Lugar
  lugar: "Salón de eventos Dgalance",
  direccion:
    "Calle 7 con Avenida Principal de Propatria, Edificio 4, Piso 1, Propatria, Caracas",
  mapsUrl:
    "https://www.google.com/maps/search/?api=1&query=Calle+7+con+Avenida+Principal+de+Propatria+Caracas",

  // 💬 WhatsApp confirmación (+58 416-6222523)
  whatsapp: "584166222523",
  mensajeWhatsApp: "¡Hola Keimar! 💖 Confirmo mi asistencia a tus XV años del 27 de diciembre 🥂",

  // 🎀 Vestimenta
  vestimenta: "Traje cóctel",

  // 🎁 MESA DE REGALOS — ✏️ EDITAR: datos de pago móvil cuando los confirmen
  pagoMovil: {
    banco: "Banco de Venezuela", // ✏️ EDITAR banco
    telefono: "0416-6222523", // ✏️ EDITAR teléfono de pago
    cedula: "V-XX.XXX.XXX", // ✏️ EDITAR cédula
    titular: "Fernando", // ✏️ EDITAR titular
  },

  /* Rutas de assets (en /public/assets/) */
  marcoBolas: "assets/marco-bolas.jpg",
  logoXv: "assets/logo-xv.jpg",
  fondoTiara: "assets/fondo-tiara.jpg",
  fondoDestellos: "assets/fondo-destellos.jpg",
  musica: "assets/musica.mp3",

  // 🖼️ Foto personal de Keimar (cuando la envían → /assets/keimar.jpg)
  fotoPortada: "assets/keimar.jpg",
};

const whatsappUrl = `https://wa.me/${datos.whatsapp}?text=${encodeURIComponent(datos.mensajeWhatsApp)}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#141018" />
    <title>{datos.nombre} — Mis XV Años ✨</title>
    <meta name="description" content={`Invitación a los XV años de ${datos.nombre} · ${datos.fechaNumerica} · ${datos.lugar}`} />

    <!-- Iconos (los mismos de tu página de Edgary) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style is:global>
      @import url("https://fonts.googleapis.com/css2?family=Great+Vibes&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500;600&display=swap");

      :root {
        --negro: #141018;
        --panel: #201b26;
        --plata: #e8e8ec;
        --plata-suave: #b9b9c2;
        --morado: #6a577a;
        --brillo: #ffffff;
        --serif: "Playfair Display", serif;
        --script: "Great Vibes", cursive;
        --sans: "Montserrat", sans-serif;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { background: var(--negro); color: var(--plata); font-family: var(--serif); overflow-x: hidden; }

      section { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2.6rem 1.4rem; }
      /* Solo portada y cierre ocupan toda la pantalla */
      section.full { min-height: 100svh; }
      .overline { font-family: var(--sans); font-weight: 400; letter-spacing: 0.4em; text-transform: uppercase; font-size: 0.68rem; color: #d9c2ff; text-shadow: 0 0 12px rgba(160,110,255,.5); }
      .linea { width: 120px; height: 1px; background: linear-gradient(90deg, transparent, #d5d5df, transparent); margin: 1.5rem auto; }
      .script { font-family: var(--script); }

      /* ✨ Texto neón — lavanda violeta para que resalte y no se pierda con el blanco */
      .neon {
        font-family: var(--script);
        color: #e9d6ff;
        text-shadow:
          0 0 6px rgba(190,140,255,0.95),
          0 0 18px rgba(150,95,255,0.6),
          0 0 42px rgba(130,80,255,0.4),
          0 0 80px rgba(110,65,255,0.22);
      }
      .btn {
        display: inline-flex; align-items: center; gap: 0.55rem;
        font-family: var(--sans); font-size: 0.78rem; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase;
        color: var(--brillo); text-decoration: none;
        padding: 1rem 2.2rem; border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.55);
        background: linear-gradient(180deg, rgba(255,255,255,0.12), rgba(255,255,255,0.02));
        box-shadow: 0 0 22px rgba(255,255,255,0.14), inset 0 0 12px rgba(255,255,255,0.08);
        backdrop-filter: blur(6px);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }
      .btn:hover { transform: translateY(-3px); box-shadow: 0 0 34px rgba(255,255,255,0.35), inset 0 0 16px rgba(255,255,255,0.14); }
      .btn.relleno { background: linear-gradient(135deg, #f5f5fa, #c9c9d6); color: #0a0a0a; border: none; }

      /* Aparición al hacer scroll */
      .reveal { opacity: 0; transform: translateY(34px); transition: opacity 1.1s ease, transform 1.1s ease; }
      .reveal.visible { opacity: 1; transform: none; }

      /* Destellos flotantes */
      .polvo { position: fixed; inset: 0; pointer-events: none; z-index: 1;
        background-image:
          radial-gradient(1.5px 1.5px at 12% 22%, rgba(255,255,255,.7) 50%, transparent 51%),
          radial-gradient(1px 1px at 34% 68%, rgba(255,255,255,.5) 50%, transparent 51%),
          radial-gradient(2px 2px at 58% 12%, rgba(255,255,255,.65) 50%, transparent 51%),
          radial-gradient(1px 1px at 74% 44%, rgba(255,255,255,.45) 50%, transparent 51%),
          radial-gradient(1.5px 1.5px at 88% 76%, rgba(255,255,255,.6) 50%, transparent 51%),
          radial-gradient(1px 1px at 48% 88%, rgba(255,255,255,.5) 50%, transparent 51%);
        animation: parpadeo 5s ease-in-out infinite alternate;
      }
      @keyframes parpadeo { from { opacity: .35; } to { opacity: .9; } }

      .desliza { position: absolute; bottom: 1.6rem; left: 50%; transform: translateX(-50%);
        font-family: var(--sans); font-size: .65rem; letter-spacing: .35em; text-transform: uppercase;
        color: var(--plata-suave); animation: flota 2.2s ease-in-out infinite; }
      @keyframes flota { 0%,100% { transform: translate(-50%, 0); opacity:.6;} 50% { transform: translate(-50%, -8px); opacity:1;} }

      /* 🪩 Tarjetas con fondos decorados como la página de ejemplo */
      .tarjeta {
        position: relative;
        overflow: hidden;
        padding: 3rem 2.2rem;
        border-radius: 18px;
        max-width: 680px;
        width: min(94vw, 680px);
        border: 1px solid rgba(255,255,255,0.16);
        box-shadow: 0 0 46px rgba(255,255,255,0.08), inset 0 0 24px rgba(255,255,255,0.05);
        background-color: var(--panel);
      }
      /* Fondos decorativos (mismos de la invitación de ejemplo) */
      .tarjeta.deco-destellos { background: url('assets/fondo-destellos.jpg') center/cover; }
      .tarjeta.deco-bolas { background: url('assets/marco-bolas.jpg') center/cover; }
      /* Velo colorido encima del decorado — tinte morado como la página de muestra */
      .tarjeta::before {
        content: "";
        position: absolute; inset: 0;
        border-radius: inherit;
        background: linear-gradient(180deg, rgba(106,87,122,0.28) 0%, rgba(32,27,38,0.62) 45%, rgba(20,16,24,0.88) 100%);
      }
      .tarjeta.deco-bolas::before {
        background: linear-gradient(180deg, rgba(106,87,122,0.35) 0%, rgba(32,27,38,0.78) 55%, rgba(20,16,24,0.94) 100%);
      }
      .tarjeta > :not(.bola) { position: relative; z-index: 2; }
      .tarjeta .bola {
        position: absolute; width: 118px; height: 118px; border-radius: 50%;
        filter: drop-shadow(0 4px 10px rgba(0,0,0,.35)) drop-shadow(0 0 10px rgba(255,255,255,.22)) brightness(1.08) contrast(1.05);
        z-index: 1; pointer-events: none;
      }
      /* Bolas completas dentro de la tarjeta (sin cortes raros) */
      .bola.arriba-izq { top: 12px; left: 12px; transform: rotate(-10deg); width: 72px; height: 72px; opacity: .95; }
      .bola.abajo-der { bottom: 12px; right: 12px; transform: scaleX(-1) rotate(10deg); width: 78px; height: 78px; opacity: .95; }
      .bola.arriba-der { top: 14px; right: 14px; transform: rotate(14deg); width: 62px; height: 62px; opacity: .95; }
      .bola.abajo-izq { bottom: 14px; left: 14px; transform: scaleX(-1) rotate(-14deg); width: 62px; height: 62px; opacity: .95; }
      /* Colgando desde arriba, como colgadas del techo */
      .bola.colgante { top: -26px; width: 92px; height: 92px; animation: balanceo 4.5s ease-in-out infinite; transform-origin: top center; }
      @keyframes balanceo { 0%,100% { transform: rotate(-7deg); } 50% { transform: rotate(7deg); } }

      /* ✨ Icono circular estilo "burbuja" (como tu página de Edgary, versión neón) */
      .icono-circulo {
        width: 74px; height: 74px; margin: 0 auto 1rem;
        display: flex; align-items: center; justify-content: center;
        border-radius: 50%;
        color: var(--brillo); font-size: 1.9rem;
        border: 1px solid rgba(255,255,255,0.45);
        background: linear-gradient(180deg, rgba(255,255,255,0.16), rgba(255,255,255,0.03));
        box-shadow: 0 0 26px rgba(255,255,255,0.22), inset 0 0 16px rgba(255,255,255,0.10);
        text-shadow: 0 0 12px rgba(255,255,255,0.65);
      }
      /* Listas de vestimenta con checks */
      .vest-lista { list-style: none; text-align: left; margin: 1.2rem auto 0; max-width: 30ch; }
      .vest-lista li { display: flex; gap: .6rem; align-items: flex-start; font-size: .95rem; line-height: 1.55; margin-bottom: .55rem; color: var(--plata); }
      .vest-lista li i { color: var(--plata); margin-top: .15rem; text-shadow: 0 0 8px rgba(255,255,255,.5); }
      .vest-lista strong { color: var(--brillo); font-weight: 600; }
      .vest-badge {
        display: inline-block; font-family: var(--sans); font-size: .68rem; letter-spacing: .2em; text-transform: uppercase;
        color: var(--brillo); padding: .35rem 1.1rem; border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.4); background: rgba(255,255,255,0.08);
      }
      /* Tarjeta de datos de pago móvil */
      .banco-box {
        text-align: left; padding: 1rem 1.1rem; border-radius: 12px; margin: 1.2rem 0;
        border: 1px solid rgba(255,255,255,0.22);
        background: rgba(255,255,255,0.06);
      }
      .banco-box .fila { display: flex; justify-content: space-between; gap: .8rem; margin-bottom: .45rem; }
      .banco-box .fila:last-child { margin-bottom: 0; }
      .banco-box small { font-family: var(--sans); font-size: .66rem; letter-spacing: .18em; color: var(--plata-suave); }
      .banco-box span { font-size: .95rem; font-weight: 600; color: var(--brillo); }
      .sub-mensaje {
        border-top: 1px solid rgba(255,255,255,0.18); margin-top: 1.3rem; padding-top: 1.1rem;
        font-size: .82rem; color: var(--plata-suave); font-style: italic;
      }
      /* Mini tarjetas internas (vestimenta iconos + regalos) */
      .mini-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-top: 2.2rem; }
      @media (max-width: 640px) { .mini-grid { grid-template-columns: 1fr; } }
      .mini-card {
        padding: 1.9rem 1.2rem; border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.18);
        background: rgba(255,255,255,0.05);
      }
      .mini-card h3 { font-family: var(--serif); font-size: 1.3rem; color: #e3c9ff; text-shadow: 0 0 14px rgba(150,95,255,.45); margin: .8rem 0 .5rem; }
      .mini-card > p, .mini-card .banco-box, .mini-card .vest-lista { position: relative; z-index: 2; }

      /* 👑 Medallón de corona (sección deseleccionada y completa, sin cortes) */
      .corona-sello {
        display: block; width: 88px; margin: 1.3rem auto .3rem;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,.55);
        box-shadow: 0 0 26px rgba(255,255,255,.4), 0 0 56px rgba(106,87,122,.6);
      }

      /* 🎵 Reproductor de música */
      .musica-toggle { border: none; cursor: pointer; }
      .progreso {
        width: min(280px, 70vw); height: 5px; margin: 1.4rem auto .9rem;
        border-radius: 999px; background: rgba(255,255,255,0.16); overflow: hidden;
      }
      .progreso > div {
        height: 100%; width: 0%;
        background: linear-gradient(90deg, var(--plata), var(--morado));
        box-shadow: 0 0 10px rgba(232,232,236,0.7);
        transition: width 0.25s linear;
      }
      .track-nombre {
        font-family: var(--serif); font-size: 1.05rem; color: var(--brillo);
        text-shadow: 0 0 12px rgba(255,255,255,.45);
      }
      .track-nombre small { display: block; font-family: var(--sans); font-size: .68rem; letter-spacing: .25em; text-transform: uppercase; color: var(--plata-suave); margin-top: .35rem; }
      .disco-giro { display: inline-block; animation: giro 3.5s linear infinite; }
      @keyframes giro { to { transform: rotate(360deg); } }

      /* Los colgantes cuelgan con el texto corriendo por debajo (sin lo tapen) */
      .tarjeta.pt-sobre { padding-top: 5.6rem; }

      /* ============ ✉️ SOBRE DE ENTRADA (adaptado de cliente-eugenia) ============ */
      #sobre {
        position: fixed; inset: 0; z-index: 80;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: clamp(.5rem, 2vh, 1rem);
        padding: clamp(.6rem, 2.5vw, 1.2rem);
        background: rgba(12, 9, 16, 0.97);
        backdrop-filter: blur(10px);
        transition: opacity .9s ease, transform .9s ease;
        overflow-y: auto; overflow-x: hidden;
      }
      #sobre.cerrado { opacity: 0; transform: scale(1.04); pointer-events: none; }
      #sobre.oculto { display: none; }
      .sobre-caja {
        position: relative;
        width: min(92vw, 420px, calc((100dvh - 110px) * 4 / 3));
        aspect-ratio: 4 / 3;
        cursor: pointer;
        filter: drop-shadow(0 25px 50px rgba(0,0,0,.65));
        perspective: 900px;
        flex-shrink: 0;
      }
      /* Interior del sobre — liso, para que no se vean líneas/puntos por arriba */
      .sobre-back {
        position: absolute; inset: 0; border-radius: 16px;
        background: linear-gradient(180deg, #332938, #241d2c);
        box-shadow: inset 0 0 60px rgba(0,0,0,.6);
      }
      /* La carta que sale del sobre */
      .cartita {
        position: absolute; left: 2.5%; right: 2.5%; top: 3%; bottom: 3%; z-index: 10;
        background:
          linear-gradient(180deg, rgba(106,87,122,0.14), rgba(106,87,122,0) 22%),
          linear-gradient(0deg, rgba(106,87,122,0.10), rgba(106,87,122,0) 20%),
          linear-gradient(180deg, #f8f5fa, #e9e0ef);
        background-color: #f4efe9;
        border-radius: 12px; border: 2px solid rgba(255,255,255,.95);
        color: #2a2233;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: clamp(.18rem, 1vw, .38rem); text-align: center;
        padding: clamp(.5rem, 2vw, 1.1rem) clamp(.6rem, 2.5vw, 1.2rem);
        opacity: 0; transform: translateY(12%) scale(.96); pointer-events: none;
        transition: opacity 1.15s cubic-bezier(.16, 1, .3, 1), transform 1.15s cubic-bezier(.16, 1, .3, 1);
        box-shadow: 0 25px 60px -12px rgba(0,0,0,.6);
        box-sizing: border-box;
      }
      .cartita.saliendo { opacity: 1; transform: translateY(-44%) scale(1.03); z-index: 10; pointer-events: auto; }
      /* Segunda fase: la carta ya salió del bolsillo y pasa por encima del frente */
      .cartita.saliendo.encima { z-index: 40; transform: translateY(0) scale(1.02); }

      .cartita .eyebrow {
        font-family: var(--sans);
        font-size: clamp(.46rem, 1.6vw, .58rem);
        letter-spacing: clamp(.1em, 0.4vw, .24em);
        text-transform: uppercase;
        color: #6a577a;
        margin: 0;
        line-height: 1.2;
        max-width: 96%;
      }
      .cartita .titulo {
        font-family: var(--script);
        color: #5b4668;
        font-size: clamp(1.2rem, 4.4vw, 1.95rem);
        margin: 0;
        line-height: 1.05;
      }
      .cartita .nombre {
        font-family: var(--script);
        color: #2a2233;
        font-size: clamp(1.4rem, 5.5vw, 2.4rem);
        line-height: 1.05;
        margin: 0;
      }
      .cartita .regla {
        width: clamp(50px, 16vw, 85px);
        height: 2px;
        background: linear-gradient(90deg, transparent, #9c86ac, transparent);
        margin: clamp(.1rem, 0.6vw, .25rem) 0;
      }
      .cartita .fecha-pill {
        font-family: var(--sans);
        font-size: clamp(.46rem, 1.6vw, .56rem);
        letter-spacing: clamp(.08em, 0.3vw, .18em);
        text-transform: uppercase;
        padding: clamp(.24rem, 0.9vw, .38rem) clamp(.55rem, 1.8vw, .9rem);
        border-radius: 999px;
        border: 1px solid #cfc0da;
        color: #3a2f42;
        max-width: 96%;
        white-space: nowrap;
      }
      .cartita-cta {
        margin-top: clamp(.3rem, 1.2vw, .7rem);
        font-family: var(--sans);
        font-size: clamp(.5rem, 1.7vw, .62rem);
        letter-spacing: clamp(.08em, 0.3vw, .15em);
        text-transform: uppercase;
        color: #fff;
        background: linear-gradient(135deg, #6a577a, #2e2536);
        padding: clamp(.45rem, 1.5vw, .68rem) clamp(.85rem, 2.8vw, 1.35rem);
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,.55);
        cursor: pointer;
        opacity: 0;
        transition: opacity .7s ease, transform .25s ease, box-shadow .25s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        box-shadow: 0 4px 14px rgba(46,37,54,.35);
        max-width: 96%;
        text-align: center;
      }
      .cartita-cta:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(46,37,54,.5); }

      /* Frente del sobre */
      .sobre-frente {
        position: absolute; left: 0; right: 0; bottom: 0; height: 83%; z-index: 20;
        background:
          linear-gradient(115deg, transparent 35%, rgba(255,255,255,0.09) 47%, transparent 58%),
          linear-gradient(180deg, #54465e, #4a3c55 45%, #2e2536);
        border-radius: 0 0 16px 16px;
        border-top: 2px solid rgba(255,255,255,.85);
        border-bottom: 2px solid rgba(255,255,255,.85);
        display: flex; flex-direction: column; align-items: center; justify-content: space-between;
        padding: clamp(.4rem, 2vw, .8rem);
        padding-top: calc(41% + 4px);
        padding-bottom: clamp(.4rem, 1.5vw, .8rem);
        transition: opacity .9s;
        overflow: hidden;
        box-sizing: border-box;
      }
      .sobre-frente::before {
        content: ""; position: absolute; inset: clamp(6px, 1.8vw, 10px);
        border: 2px dashed rgba(255,255,255,.8); border-radius: clamp(8px, 2.2vw, 12px);
        pointer-events: none;
      }

      /* Contenedor del texto del frente */
      .sobre-info {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        text-align: center; gap: clamp(2px, 0.8vw, 5px);
        width: 100%; min-width: 0;
        pointer-events: none;
        position: relative; z-index: 30;
      }
      .sobre-eyebrow {
        font-family: var(--sans);
        font-size: clamp(.48rem, 1.8vw, .56rem);
        letter-spacing: clamp(.1em, 0.4vw, .22em);
        text-transform: uppercase;
        color: var(--plata);
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.4);
        padding: .2rem .75rem;
        border-radius: 999px;
        white-space: nowrap;
        max-width: 92%;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .sobre-titulo {
        font-family: var(--script);
        color: #fff;
        font-size: clamp(1.4rem, 5.2vw, 2.2rem);
        line-height: 1.1;
        margin: 0;
        white-space: nowrap;
        text-shadow: 0 0 16px rgba(255,255,255,.7), 0 0 40px rgba(190,160,230,.4);
      }
      .sobre-nombre {
        font-family: var(--serif);
        font-style: italic;
        letter-spacing: clamp(.06em, 0.3vw, .14em);
        color: #ddd3e6;
        font-size: clamp(.78rem, 2.8vw, .95rem);
        line-height: 1.15;
        margin: 0;
        text-align: center;
        max-width: 94%;
      }

      /* Lazo de raso y cinta horizontal */
      .sobre-cinta-lazo {
        position: relative;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: auto;
        z-index: 30;
        pointer-events: none;
      }
      .sobre-cinta-horizontal {
        position: absolute;
        left: 0; right: 0;
        top: 44%;
        transform: translateY(-50%);
        height: clamp(10px, 2.8vw, 16px);
        background: linear-gradient(90deg, rgba(36,29,44,0.3) 0%, rgba(143,127,165,0.75) 25%, #f2eef6 50%, rgba(143,127,165,0.75) 75%, rgba(36,29,44,0.3) 100%);
        border-top: 1.5px solid rgba(255,255,255,.9);
        border-bottom: 1.5px solid rgba(255,255,255,.9);
        box-shadow: 0 0 12px rgba(255,255,255,.45);
      }
      .sobre-lazo {
        width: clamp(74px, 22vw, 114px);
        position: relative;
        z-index: 2;
        margin: 0 auto;
        filter: drop-shadow(0 4px 10px rgba(0,0,0,.55));
      }
      .sobre-lazo svg { display: block; width: 100%; height: auto; }

      /* Solapa superior en V */
      .solapa {
        position: absolute; top: 0; left: 0; right: 0; height: 42%; z-index: 30;
        background: linear-gradient(180deg, #4a3c55, #3a2f42);
        clip-path: polygon(0 0, 100% 0, 100% 50%, 50% 100%, 0 50%);
        transform-origin: top center; transition: transform 1.2s cubic-bezier(.4, 0, .2, 1);
        border-radius: 16px 16px 0 0;
      }
      .solapa::after {
        content: ""; position: absolute; left: 0; right: 0; top: 0; height: 100%;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 120' preserveAspectRatio='none'><path d='M 10 50 L 200 110 L 390 50' stroke='white' stroke-width='2.5' stroke-dasharray='6 4' fill='none' opacity='0.9'/></svg>");
        background-size: 100% 100%;
      }
      .solapa.abierta { transform: rotateX(-180deg); opacity: .2; z-index: 5; pointer-events: none; }

      /* Sello con corona/latido en la punta de la solapa */
      .sello-sobre {
        position: absolute; left: 50%; top: 42%; transform: translate(-50%, -56%);
        width: clamp(44px, 12vw, 60px); height: clamp(44px, 12vw, 60px);
        border-radius: 50%; z-index: 35;
        background: linear-gradient(180deg, #f2eef6, #a99bc4);
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 0 22px rgba(255,255,255,.6), 0 0 44px rgba(106,87,122,.6);
        border: 2px solid rgba(255,255,255,.9);
        transition: opacity .8s ease, transform .8s ease;
        pointer-events: none;
      }
      .sello-img {
        width: 100%; height: 100%; border-radius: 50%; object-fit: cover; object-position: center 38%;
      }
      .sello-giro {
        position: absolute; inset: clamp(-6px, -1.6vw, -8px);
        border: 2px dashed rgba(255,255,255,.9); border-radius: 50%;
        animation: giro 24s linear infinite;
        pointer-events: none;
      }
      /* Chispas al abrir */
      .chispa {
        position: fixed; width: 6px; height: 6px; border-radius: 50%;
        z-index: 90; pointer-events: none;
        animation: chispa 1.4s ease-out forwards;
        box-shadow: 0 0 10px rgba(255,255,255,.9);
      }
      @keyframes chispa {
        from { transform: translate(0, 0) scale(1); opacity: 1; }
        to { transform: translate(var(--x), var(--y)) scale(.2); opacity: 0; }
      }

      /* Cuenta regresiva */
      .cuenta { display: flex; gap: .9rem; justify-content: center; margin-top: 1.8rem; flex-wrap: wrap; }
      .cuenta .caja {
        min-width: 74px; padding: 1rem .6rem 1.2rem; border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.18);
        background: linear-gradient(180deg, rgba(255,255,255,0.07), rgba(255,255,255,0.015));
        box-shadow: inset 0 0 18px rgba(255,255,255,0.05);
      }
      .cuenta-num { font-family: var(--serif); font-size: clamp(1.7rem, 5.5vw, 2.6rem); font-weight: 600; color: var(--brillo);
        text-shadow: 0 0 14px rgba(255,255,255,0.5); }
      @media (max-width: 480px) {
        .cuenta { gap: .45rem; }
        .cuenta .caja { min-width: 60px; padding: .75rem .35rem 1rem; border-radius: 10px; }
        .cuenta-num { font-size: 1.6rem; }
        .tarjeta { padding: 2.2rem 1.2rem; }
      }
    </style>
  </head>
  <body>
    <div class="polvo"></div>

    <!-- ============ ✉️ SOBRE DE ENTRADA ============ -->
    <div id="sobre">
      <div class="sobre-caja" id="sobreCaja">
        <!-- 1. Interior / bolsillo trasero -->
        <div class="sobre-back"></div>

        <!-- 2. La carta que sale del sobre -->
        <div class="cartita" id="cartita">
          <p class="eyebrow">Estás cordialmente invitado a festejar</p>
          <h3 class="titulo">Mis XV Años</h3>
          <p class="nombre">{datos.nombre}</p>
          <div class="regla"></div>
          <span class="fecha-pill">✨ {datos.fechaTexto} {datos.fechaNumerica} ✨</span>
          <button type="button" class="cartita-cta" id="ctaEntrar">
            <span>Toca para ver la invitación principal</span> <i class="bi bi-arrow-right"></i>
          </button>
        </div>

        <!-- 3. Frente del sobre -->
        <div class="sobre-frente" id="sobreFrente">
          <div class="sobre-info">
            <span class="sobre-eyebrow">✦ Invitación Real Exclusiva ✦</span>
            <h2 class="sobre-titulo">Mis XV Años</h2>
            <p class="sobre-nombre">{datos.nombre}</p>
          </div>

          <!-- Lazo de raso y cinta horizontal que abarca el ancho completo -->
          <div class="sobre-cinta-lazo">
            <div class="sobre-cinta-horizontal"></div>
            <div class="sobre-lazo">
              <svg width="100%" viewBox="0 0 260 140" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="lazoPlata" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#f5f2fa" />
                    <stop offset="35%" stop-color="#c3b3d6" />
                    <stop offset="70%" stop-color="#6a577a" />
                    <stop offset="100%" stop-color="#2e2536" />
                  </linearGradient>
                  <linearGradient id="lazoPlataOscuro" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#9c86ac" />
                    <stop offset="60%" stop-color="#4a3c55" />
                    <stop offset="100%" stop-color="#191420" />
                  </linearGradient>
                </defs>
                <path d="M120 65 C110 85 75 115 55 138 L82 130 L98 140 C108 115 118 90 122 65 Z" fill="url(#lazoPlataOscuro)" stroke="#ffffff" stroke-width="1.4" opacity="0.95" />
                <path d="M140 65 C150 85 185 115 205 138 L178 130 L162 140 C152 115 142 90 138 65 Z" fill="url(#lazoPlataOscuro)" stroke="#ffffff" stroke-width="1.4" opacity="0.95" />
                <path d="M130 60 C98 28 25 25 15 55 C5 84 82 94 130 68 Z" fill="url(#lazoPlata)" stroke="#ffffff" stroke-width="1.8" />
                <path d="M130 60 C162 28 235 25 245 55 C255 84 178 94 130 68 Z" fill="url(#lazoPlata)" stroke="#ffffff" stroke-width="1.8" />
                <path d="M130 60 C105 40 45 36 35 56 C46 66 100 74 130 68 Z" fill="#150f1a" opacity="0.45" />
                <path d="M130 60 C155 40 215 36 225 56 C214 66 160 74 130 68 Z" fill="#150f1a" opacity="0.45" />
                <ellipse cx="130" cy="61" rx="17" ry="13" fill="url(#lazoPlata)" stroke="#ffffff" stroke-width="1.8" />
              </svg>
            </div>
          </div>
        </div>

        <!-- 4. Solapa superior en V -->
        <div class="solapa" id="solapa"></div>

        <!-- 5. Sello de corona sobre la punta de la solapa -->
        <div id="selloSobre" class="sello-sobre">
          <img src="assets/corona.png" alt="" aria-hidden="true" class="sello-img" />
          <span class="sello-giro"></span>
        </div>
      </div>
      <p style="font-family:var(--sans); font-size:.6rem; letter-spacing:.3em; text-transform:uppercase; color:var(--plata-suave);">
        Toca el sobre para abrir
      </p>
    </div>

    <!-- 🎵 Botón flotante rápido -->
    <button id="musicaBtn" class="musica-toggle" aria-label="Reproducir o pausar música" title="Música"
      style="position:fixed; top:1rem; right:1rem; z-index:10; width:46px; height:46px; border-radius:50%;
             border:1px solid rgba(255,255,255,.4); background:rgba(255,255,255,.08); color:#fff;
             font-size:1.2rem; cursor:pointer; backdrop-filter:blur(6px);">
      <i class="musica-icono bi bi-play-fill"></i>
    </button>
    <audio id="musica" src={datos.musica} loop preload="none"></audio>

    <!-- ============ 1. PORTADA ============ -->
    <section id="portada" class="full" style="padding:0;">
      <!-- Marco de bolas de espejo -->
      <img src={datos.marcoBolas} alt="" aria-hidden="true"
        style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center top;" />
      <div style="position:absolute; inset:0; background: radial-gradient(ellipse at 50% 55%, rgba(20,16,24,0.22), rgba(20,16,24,0.8) 78%);"></div>

      <div style="position:relative; z-index:2; display:flex; flex-direction:column; align-items:center; padding: 4rem 1.4rem 6rem;">
        <img src={datos.logoXv} alt="Mis XV Años" draggable="false"
          style="width: min(230px, 56vw); border-radius: 24px; box-shadow: 0 0 40px rgba(255,255,255,0.22); margin-bottom: 2.6rem;" />

        <p class="overline reveal visible" style="margin-bottom:1rem;">Mis XV años</p>
        <h1 class="neon" style="font-size: clamp(2.6rem, 11vw, 5.4rem); line-height: 1.15; font-weight: 400;">
          {datos.nombrePortada[0]}<br />{datos.nombrePortada[1]}
        </h1>
        <div class="linea"></div>

        <p style="font-family:var(--sans); font-weight:300; letter-spacing:.45em; text-transform:uppercase; font-size:.85rem; color:var(--brillo); text-shadow:0 0 12px rgba(255,255,255,.6);">
          {datos.fechaTexto}
        </p>
        <p style="font-family:var(--serif); font-size:1.25rem; color:var(--plata); margin-top:.5rem;">{datos.fechaNumerica}</p>

        <!--Foto de Keimar: se muestra apenas la suba a /assets/keimar.jpg -->
        <div id="fotoWrap" class="reveal" style="margin-top:3rem; display:none;">
          <div style="width:min(220px,58vw); height:min(220px,58vw); border-radius:50%; padding:4px; background:linear-gradient(135deg,#fff,rgba(255,255,255,.1)); box-shadow:0 0 34px rgba(255,255,255,.28);">
            <img src={datos.fotoPortada} alt={datos.nombre} style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 1.5 REPRODUCTOR DE MÚSICA ============ -->
    <section id="reproductor" style="padding-top:2.2rem;">
      <div class="tarjeta deco-destellos reveal">
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola arriba-izq" />
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola abajo-der" />

        <span class="vest-badge"><i class="bi bi-disc-fill me-1 disco-giro"></i> Música de Fondo</span>

        <button class="icono-circulo musica-toggle" aria-label="Reproducir o pausar la música"
          style="margin-top:1.5rem;">
          <i class="musica-icono bi bi-play-fill"></i>
        </button>

        <div class="progreso"><div id="musicaProgreso"></div></div>
        <p class="track-nombre">
          Perfect — Ed Sheeran
          <small>Piano & Cello · Instrumental</small>
        </p>
        <p class="overline" style="margin-top:1rem; letter-spacing:.28em;">Toca para escuchar la canción del evento 🎶</p>
      </div>
    </section>

    <!-- ============ 2. CONTADOR ============ -->
    <section id="contador">
      <div class="tarjeta deco-destellos pt-sobre reveal">
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola colgante" style="left: 6%;" />
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola arriba-der" />
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola abajo-izq" />
        <p class="overline">Falta tan poco para celebrar</p>
        <div class="linea"></div>
        <div id="cuenta" class="cuenta">
          {["días", "hrs", "min", "seg"].map((et) => (
            <div class="caja">
              <div data-num class="cuenta-num">—</div>
              <div class="overline" style="letter-spacing:.3em; margin-top:.5rem; font-size:.6rem;">{et}</div>
            </div>
          ))}
        </div>
      </div>
      <script>
        const objetivo = new Date(2026, 11, 27, 21, 0, 0).getTime(); // ⚠️ misma fecha y hora que arriba
        const nums = document.querySelectorAll("#cuenta [data-num]");
        const tick = () => {
          const rest = Math.max(0, objetivo - Date.now());
          const dias = Math.floor(rest / 864e5), horas = Math.floor(rest / 36e5) % 24,
                min = Math.floor(rest / 6e4) % 60, seg = Math.floor(rest / 1e3) % 60;
          [dias, horas, min, seg].forEach((v, i) => (nums[i].textContent = String(v).padStart(2, "0")));
        };
        tick(); setInterval(tick, 1000);
      </script>
    </section>

    <!-- ============ 3. UBICACIÓN ============ -->
    <section id="ubicacion">
      <div class="tarjeta deco-destellos pt-sobre reveal">
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola colgante" style="left: 5%;" />
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola arriba-izq" />
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola abajo-der" />
        <p class="overline">Ubicación</p>
        <img src="assets/corona.png" alt="" aria-hidden="true" class="corona-sello" />
        <div class="linea reveal"></div>
        <p class="reveal" style="font-style:italic; font-size:1.15rem; line-height:1.7; color:var(--plata-suave);">
          Con ilusión y alegría, celebro mis quince años, rodeada de las personas más especiales de mi vida.
        </p>

        <h2 class="reveal" style="font-family:var(--serif); font-size:1.7rem; margin-top:2rem; color:#e9d6ff; text-shadow:0 0 16px rgba(150,95,255,.5);">
          {datos.lugar}
        </h2>
        <p class="reveal" style="margin-top:.8rem; color:var(--plata-suave); font-size:.95rem; line-height:1.6;">
          {datos.direccion}
        </p>

        <a href={datos.mapsUrl} target="_blank" rel="noopener" class="btn relleno reveal" style="margin-top:2.2rem; color:#0a0a0a;">Ver ubicación 📍</a>

        <p class="script reveal" style="font-size:1.7rem; margin-top:2.6rem; color:var(--plata); text-shadow:0 0 14px rgba(255,255,255,.4);">
          ¡No faltes!
        </p>
      </div>
    </section>

    <!-- ============ 4. DEDICATORIA Y PADRES ============ -->
    <section id="padres">
      <div class="tarjeta deco-destellos pt-sobre reveal">
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola arriba-izq" />
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola colgante" style="left: auto; right: 5%;" />
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola abajo-der" />
        <p class="script neon reveal" style="font-size: clamp(2rem, 7vw, 3.4rem); line-height:1.3;">
          "Acompáñame a celebrar mis XV años y hagamos esta noche inolvidable"
        </p>
        <div class="linea reveal"></div>
        <p class="overline reveal">Con la bendición de Dios y de mis padres</p>
        <img src="assets/corona.png" alt="" aria-hidden="true" class="corona-sello" />
        <h3 class="reveal" style="margin-top:1.6rem; font-size:1.6rem; font-weight:600; color:#e9d6ff; text-shadow:0 0 18px rgba(150,95,255,.55);">{datos.padres[0]}</h3>
        <p class="reveal" style="color:var(--plata-suave); margin:.2rem 0;">&</p>
        <h3 class="reveal" style="font-size:1.6rem; font-weight:600; color:#e9d6ff; text-shadow:0 0 18px rgba(150,95,255,.55);">{datos.padres[1]}</h3>
      </div>
    </section>

    <!-- ============ 5. CONFIRMAR ASISTENCIA ============ -->
    <section id="asistencia">
      <div class="tarjeta deco-bolas pt-sobre reveal">
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola colgante" style="left: 6%;" />
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola arriba-izq" />
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola abajo-der" />
        <p class="overline">Confirmar Asistencia</p>
        <div class="linea"></div>
        <p style="max-width:38ch; margin:0 auto; text-align:center; font-style:italic; font-size:1.15rem; line-height:1.8; color:var(--plata);">
          "El mejor regalo será contar con tu compañía. Si aún así deseas hacerme un presente, te agradeceré un aporte monetario para la ocasión."
        </p>
        <a href={whatsappUrl} target="_blank" rel="noopener" class="btn relleno" style="margin-top:2.4rem; color:#0a0a0a;">Confirmar por WhatsApp 💬</a>
        <p class="overline" style="margin-top:1.5rem; letter-spacing:.2em;">No. de contacto: 0416-6222523</p>
      </div>
    </section>

    <!-- ============ 6. CÓDIGO DE VESTIMENTA ============ -->
    <section id="vestimenta">
      <div class="tarjeta deco-destellos reveal">
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola arriba-der" />
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola abajo-izq" />
        <p class="overline">Código de Vestimenta</p>
        <div class="linea"></div>
        <h2 class="script neon" style="font-size:clamp(2.2rem,7vw,3.4rem);">{datos.vestimenta}</h2>
        <p style="color:var(--plata-suave); font-style:italic; font-size:.98rem; margin-top:.6rem;">
          Queremos que esta noche brilles tanto como los focos de la pista ✨
        </p>

        <div class="mini-grid">
          <!-- Damas -->
          <div class="mini-card">
            <div class="icono-circulo" style="width:60px;height:60px;font-size:1.4rem;">
              <i class="bi bi-gender-female"></i>
            </div>
            <h3>Para Ellas</h3>
            <span class="vest-badge">Damas & Invitadas</span>
            <ul class="vest-lista">
              <li><i class="bi bi-check-circle-fill"></i><span><strong>Vestidos:</strong> cóctel, midi o largos fluidos y elegantes.</span></li>
              <li><i class="bi bi-check-circle-fill"></i><span><strong>Conjuntos:</strong> trajes de dos piezas o enterizos de gala.</span></li>
              <li><i class="bi bi-check-circle-fill"></i><span><strong>Calzado:</strong> tacones o sandalias cómodas para bailar.</span></li>
            </ul>
            <p class="sub-mensaje"><i class="bi bi-stars me-1"></i> Accesorios brillantes y tonos festivos.</p>
          </div>
          <!-- Caballeros -->
          <div class="mini-card">
            <div class="icono-circulo" style="width:60px;height:60px;font-size:1.4rem;">
              <i class="bi bi-gender-male"></i>
            </div>
            <h3>Para Ellos</h3>
            <span class="vest-badge">Caballeros & Invitados</span>
            <ul class="vest-lista">
              <li><i class="bi bi-check-circle-fill"></i><span><strong>Traje o blazer:</strong> saco semi-formal o traje completo.</span></li>
              <li><i class="bi bi-check-circle-fill"></i><span><strong>Camisa & pantalón:</strong> camisa de vestir con pantalón elegante.</span></li>
              <li><i class="bi bi-check-circle-fill"></i><span><strong>Calzado:</strong> zapatos de vestir; corbata o pajarita opcional.</span></li>
            </ul>
            <p class="sub-mensaje"><i class="bi bi-suit-club-fill me-1"></i> Estilo pulcro y sofisticado.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 7. MESA DE REGALOS ============ -->
    <section id="regalos">
      <div class="tarjeta deco-destellos pt-sobre reveal">
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola colgante" style="left: auto; right: 5%;" />
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola arriba-der" />
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola abajo-izq" />

        <p class="overline">Detalles de Regalos</p>
        <img src="assets/corona.png" alt="" aria-hidden="true" class="corona-sello" />
        <div class="linea"></div>
        <h2 class="script neon" style="font-size:clamp(2.2rem,7vw,3.2rem);">Mesa de Regalos</h2>
        <p style="color:var(--plata-suave); font-style:italic; font-size:.98rem; margin-top:.6rem;">
          Tu presencia es el mejor regalo para mí, pero si deseas hacerme un obsequio, aquí te comparto las opciones.
        </p>

        <div class="mini-grid" style="margin-top:1.8rem;">
          <!-- Opción 1: Lluvia de Sobres -->
          <div class="mini-card">
            <div class="icono-circulo"><i class="bi bi-envelope-paper-heart-fill"></i></div>
            <h3>Lluvia de Sobres</h3>
            <span class="vest-badge">En el salón</span>
            <p style="font-size:.92rem; color:var(--plata); line-height:1.6; margin-top:1rem;">
              Habrá un buzón especial de <strong style="color:var(--brillo)">Lluvia de Sobres</strong> en la recepción del evento.
            </p>
            <p class="sub-mensaje"><i class="bi bi-envelope-fill me-1"></i> Encontrarás el buzón al entrar a la fiesta.</p>
          </div>

          <!-- Opción 2: Regalo Digital / Pago Móvil -->
          <div class="mini-card">
            <div class="icono-circulo"><i class="bi bi-bank2"></i></div>
            <h3>Regalo Digital</h3>
            <span class="vest-badge">Pago Móvil & Transferencia</span>
            <div class="banco-box">
              <div class="fila"><small>BANCO:</small><span>{datos.pagoMovil.banco}</span></div>
              <div class="fila"><small>TELÉFONO:</small><span>{datos.pagoMovil.telefono}</span></div>
              <div class="fila"><small>CÉDULA:</small><span>{datos.pagoMovil.cedula}</span></div>
              <div class="fila"><small>TITULAR:</small><span>{datos.pagoMovil.titular}</span></div>
            </div>
            <button type="button" class="btn relleno" id="copiarDatos"
              data-bank-info={`Banco: ${datos.pagoMovil.banco} | Teléfono: ${datos.pagoMovil.telefono} | Cédula: ${datos.pagoMovil.cedula} | Titular: ${datos.pagoMovil.titular}`}
              style="width:100%; color:#0a0a0a; font-size:.68rem;">
              <i class="bi bi-clipboard-check me-1"></i> Copiar Datos de Pago
            </button>
            <small id="copiadoMsg" style="display:none; color:#9fffb0; margin-top:.6rem; font-size:.78rem; letter-spacing:.1em;">
              <i class="bi bi-check-all me-1"></i> ¡Datos copiados al portapapeles!
            </small>
          </div>

          <!-- Opción 3: Regalo Físico -->
          <div class="mini-card" style="grid-column: 1 / -1;">
            <div class="icono-circulo"><i class="bi bi-gift-fill"></i></div>
            <h3>Regalo Físico</h3>
            <span class="vest-badge">En la recepción</span>
            <p style="font-size:.92rem; color:var(--plata); line-height:1.6; margin-top:1rem;">
              Si prefieres traer un obsequio envuelto, habrá una <strong style="color:var(--brillo)">mesa especial de regalos</strong> dispuesta para recibirlo con mucho cariño.
            </p>
            <p class="sub-mensaje"><i class="bi bi-box-seam-fill me-1"></i> Ubicada junto al buzón de sobres.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 8. GALERÍA (v2) ============ -->
    <section id="galeria">
      <div class="tarjeta deco-destellos reveal">
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola arriba-izq" />
        <img src="assets/bola-a.png" alt="" aria-hidden="true" class="bola abajo-der" />
        <p class="overline">Próximamente</p>
        <img src="assets/corona.png" alt="" aria-hidden="true" class="corona-sello" />
        <div class="linea"></div>
        <h2 class="script neon" style="font-size:clamp(2.2rem,7vw,3.4rem);">Galería de fotos</h2>
        <p style="color:var(--plata-suave); max-width:38ch; margin:1.5rem auto 0; font-style:italic;">
          Muy pronto podrás ver y compartir fotos del evento mediante un álbum en línea.
        </p>
      </div>
    </section>

    <!-- ============ 8. CIERRE ============ -->
    <section id="cierre" class="full" style="background-image:url({datos.marcoBolas}); background-size:cover; background-position:center;">
      <div style="position:absolute; inset:0; background:rgba(20,16,24,.75);"></div>
      <div style="position:relative; z-index:2;">
        <h2 class="script neon reveal" style="font-size:clamp(2.6rem,9vw,4.6rem);">Te espero ✨</h2>
        <p class="overline reveal" style="margin-top:1.2rem;">{datos.nombre} · XV Años</p>
        <div class="linea reveal"></div>
        <a href={whatsappUrl} target="_blank" rel="noopener" class="btn relleno reveal" style="color:#0a0a0a;">¡No faltes! 🥂</a>
      </div>
    </section>

    <script>
      // Aparición al hacer scroll
      const obs = new IntersectionObserver(
        (es) => es.forEach((e) => e.isIntersecting && e.target.classList.add("visible")),
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach((el) => obs.observe(el));
    </script>

    <script>
      // 🎵 Reproductor de música (funciona en iOS: reproducir con 1er toque)
      const audio = document.getElementById("musica");
      const iconoMusica = document.querySelectorAll(".musica-icono");
      const barraProgreso = document.getElementById("musicaProgreso");

      function alternaMusica() {
        if (audio.paused) {
          audio.play().catch(() => {});
          iconoMusica.forEach((i) => (i.className = "musica-icono bi bi-pause-fill"));
        } else {
          audio.pause();
          iconoMusica.forEach((i) => (i.className = "musica-icono bi bi-play-fill"));
        }
      }
      document.querySelectorAll(".musica-toggle").forEach((b) => b.addEventListener("click", alternaMusica));

      // Expuesto para que el sobre de entrada pueda arrancar la música
      window.__tocarMusica = () => { if (audio.paused) alternaMusica(); };

      // Progreso de la canción
      audio.addEventListener("timeupdate", () => {
        if (audio.duration) barraProgreso.style.width = (audio.currentTime / audio.duration) * 100 + "%";
      });

      // Arranca la música al tocar "Ver invitación" en la portada
      const btnAbrir = document.getElementById("btnAbrirInvitacion");
      btnAbrir?.addEventListener("click", () => {
        if (audio.paused) alternaMusica();
      });
    </script>

    <script>
      // ✉️ Sobre de entrada (adaptado de tu reperto de Valeri/cliente-eugenia)
      const sobreOverlay = document.getElementById("sobre");
      const cajaSobre = document.getElementById("sobreCaja");
      const solapaSobre = document.getElementById("solapa");
      const cartitaSobre = document.getElementById("cartita");
      const selloFrontal = document.getElementById("selloSobre");
      const ctaCarta = document.getElementById("ctaEntrar");
      let estadoSobre = "cerrado";

      // Bloquear scroll hasta abrir el sobre
      document.body.style.overflow = "hidden";

      function lanzarChispas() {
        const r = cajaSobre.getBoundingClientRect();
        const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
        for (let i = 0; i < 42; i++) {
          const chispa = document.createElement("span");
          chispa.className = "chispa";
          const ang = Math.random() * Math.PI * 2;
          const dist = 90 + Math.random() * 170;
          chispa.style.left = cx + "px";
          chispa.style.top = cy + "px";
          chispa.style.setProperty("--x", Math.cos(ang) * dist + "px");
          chispa.style.setProperty("--y", Math.sin(ang) * dist + "px");
          chispa.style.background = ["#ffffff", "#e8e8ec", "#c3aee0", "#f0dcb0"][i % 4];
          document.body.appendChild(chispa);
          setTimeout(() => chispa.remove(), 1500);
        }
      }

      function abrirSobre() {
        if (estadoSobre !== "cerrado") return;
        estadoSobre = "abriendo";
        // 1) La solapa en V se abre hacia arriba (con desvanecimiento para que no moleste)
        solapaSobre.classList.add("abierta");
        // 2) El sello desaparece con un suave zoom
        selloFrontal.style.opacity = "0";
        selloFrontal.style.transform = "translate(-50%,-56%) scale(1.25)";
        // 3) Chispas de purpurina
        lanzarChispas();
        // 4) 🎵 Arranca la música
        window.__tocarMusica && window.__tocarMusica();
        // 5) La carta asoma POR DENTRO del bolsillo (solo la punta visible)
        setTimeout(() => cartitaSobre.classList.add("saliendo"), 700);
        // 6) Cuando ya salió, pasa por encima del sobre y se asienta en el centro
        setTimeout(() => cartitaSobre.classList.add("encima"), 1750);
        // 7) Aparece el botón para entrar
        setTimeout(() => { ctaCarta.style.opacity = "1"; estadoSobre = "abierto"; }, 2450);
      }

      function entrarInvitacion() {
        if (estadoSobre !== "abierto") return;
        estadoSobre = "saliendo";
        sobreOverlay.classList.add("cerrado");
        setTimeout(() => {
          sobreOverlay.classList.add("oculto");
          document.body.style.overflow = "";
        }, 950);
      }

      cajaSobre.addEventListener("click", () => {
        estadoSobre === "cerrado" ? abrirSobre() : entrarInvitacion();
      });
      ctaCarta.addEventListener("click", (e) => {
        e.stopPropagation();
        entrarInvitacion();
      });
    </script>

    <script>
      // Copiar datos de pago al portapapeles (como en la página de Edgary)
      const btnCopiar = document.getElementById("copiarDatos");
      const msgCopiado = document.getElementById("copiadoMsg");
      btnCopiar?.addEventListener("click", () => {
        navigator.clipboard
          .writeText(btnCopiar.dataset.bankInfo || "")
          .then(() => {
            msgCopiado.style.display = "block";
            setTimeout(() => (msgCopiado.style.display = "none"), 3000);
          })
          .catch(() => alert("No se pudo copiar. Copia manual: " + btnCopiar.dataset.bankInfo));
      });
    </script>

    <script>
      // Aparecer botón Confirma al footer? (reservado para v2: contador de asistentes)
    </script>
  </body>
</html>
